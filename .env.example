# APP_URL: Public base URL for this app. Used for self-referential links and
# any server-generated absolute URLs.
APP_URL="http://localhost:3000"

# TRUST_PROXY: believe X-Forwarded-Proto / X-Forwarded-Host when a reverse proxy
# terminates TLS in front of the app. Off unless set to "true", because those
# headers are attacker-controlled on a directly-exposed port and they feed the
# canonical tag. They are only consulted when APP_URL is unset, so leaving this
# alone costs nothing on a host that sets APP_URL.
TRUST_PROXY="false"

# PORT: Express listen port. When busy, the server walks to the next free port
# unless STRICT_PORT is "true".
PORT="3000"

# STRICT_PORT: When "true", fail instead of walking to the next free port.
# Useful in CI, where a silently-moved port makes tests target the wrong server.
STRICT_PORT="false"

# DISABLE_HMR: When "true", run the Vite dev middleware without hot reload.
DISABLE_HMR="false"

# FOOTBALL_DATA_TOKEN: free API token from https://www.football-data.org/client/register
# Campeonato Brasileiro Série A (code BSA) is on the free TIER_ONE plan, capped
# at 10 requests/minute — the server's TTL cache keeps usage well under that.
# Optional: when unset the app serves the seed fixtures as source:"placeholder",
# so a fresh clone runs with no signup.
FOOTBALL_DATA_TOKEN=""

# DISABLE_FOOTBALL_DATA: when "true", skip the provider entirely and serve seed
# fixtures. Kill switch for incidents — no code change or token removal needed.
DISABLE_FOOTBALL_DATA="false"

# FOOTBALL_DATA_TIMEOUT_MS: per-request upstream timeout. Defaults to 6000.
FOOTBALL_DATA_TIMEOUT_MS="6000"
