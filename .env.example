# APP_URL: Public base URL for this app. Used for self-referential links and
# any server-generated absolute URLs.
APP_URL="http://localhost:3000"

# TRUST_PROXY: believe X-Forwarded-Proto / X-Forwarded-Host when a reverse proxy
# terminates TLS in front of the app. Off unless set to "true", because those
# headers are attacker-controlled on a directly-exposed port and they feed the
# canonical tag. They are only consulted when APP_URL is unset, so leaving this
# alone costs nothing on a host that sets APP_URL.
TRUST_PROXY="false"

# PORT: Express listen port. When busy, the server walks to the next free port
# unless STRICT_PORT is "true".
PORT="3000"

# STRICT_PORT: When "true", fail instead of walking to the next free port.
# Useful in CI, where a silently-moved port makes tests target the wrong server.
STRICT_PORT="false"

# DISABLE_HMR: When "true", run the Vite dev middleware without hot reload.
DISABLE_HMR="false"

# FOOTBALL_DATA_TOKEN: free API token from https://www.football-data.org/client/register
# Campeonato Brasileiro Série A (code BSA) is on the free TIER_ONE plan, capped
# at 10 requests/minute — the server's TTL cache keeps usage well under that.
# Optional: when unset the app serves the seed fixtures as source:"placeholder",
# so a fresh clone runs with no signup.
FOOTBALL_DATA_TOKEN=""

# DISABLE_FOOTBALL_DATA: when "true", skip the provider entirely and serve seed
# fixtures. Kill switch for incidents — no code change or token removal needed.
DISABLE_FOOTBALL_DATA="false"

# FOOTBALL_DATA_TIMEOUT_MS: per-request upstream timeout. Defaults to 6000.
FOOTBALL_DATA_TIMEOUT_MS="6000"

# GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET: an OAuth 2.0 "Web application"
# client from https://console.cloud.google.com → Google Auth Platform → Clients.
# Register exactly these redirect URIs, which is the path the app serves:
#   https://<your APP_URL>/api/auth/callback
#   http://localhost:3000/api/auth/callback
# Leave "Authorized JavaScript origins" empty — the flow is server-side and no
# Google script runs on the page.
#
# Optional, and unset is a supported state: with either of them missing the
# accounts feature is ABSENT rather than broken — no control renders, /conta and
# /entrar answer 404, and the app is exactly what it was before accounts
# existed. A fresh clone needs no signup, as with FOOTBALL_DATA_TOKEN.
#
# There is deliberately no SESSION_SECRET. Sessions are opaque random tokens
# stored as SHA-256 digests in a table, so there is nothing to sign and no
# secret whose absence has to be handled.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ACCOUNTS_DB: where the SQLite file lives. Defaults to ./data/accounts.db.
# On the host it must stay inside DEPLOY_DIR — the systemd unit sets
# ProtectSystem=strict with ReadWritePaths=${DEPLOY_DIR}, so /var/lib is
# read-only to the process — and outside dist/, which both rsyncs delete with
# --delete and express.static serves over HTTP.
ACCOUNTS_DB=""

# ACCOUNTS_DEV_LOGIN: when "true", expose POST /api/auth/dev-login, which mints
# a session for anybody who asks. For the end-to-end suite, so sign-in is tested
# without a Google client and without network — CI has no secrets by design.
# The server REFUSES TO START with this set when NODE_ENV=production.
ACCOUNTS_DEV_LOGIN="false"
