{
  "name": "portal-brasileirao",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "./scripts/build.sh",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test:unit": "node --import tsx --test tests/standings-core.test.ts tests/matches-core.test.ts tests/football-data-core.test.ts tests/cache-core.test.ts tests/club-core.test.ts tests/route-core.test.ts tests/player-core.test.ts tests/broadcast-core.test.ts tests/match-core.test.ts tests/page-meta-core.test.ts tests/theme-core.test.ts tests/button-classes.test.ts",
    "deploy": "./scripts/deploy.sh",
    "deploy:preflight": "./scripts/deploy-preflight.sh",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "sync-broadcasts": "tsx scripts/sync-broadcasts.ts",
    "screenshot": "tsx scripts/screenshot.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.0.0"
  }
}
